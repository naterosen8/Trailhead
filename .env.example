# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both under Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in client-side code — it's designed for
# this and is restricted by the Row Level Security policies in supabase/schema.sql.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
